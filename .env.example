# ==============================================================================
# Netu Techno — Environment Configuration Guide
# ==============================================================================

# Site URL (Canonical URL for SEO, Open Graph tags, and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://netutechno.com

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Contact Form Details (Publicly visible placeholder overrides)
NEXT_PUBLIC_CONTACT_EMAIL=info@netutechno.com
NEXT_PUBLIC_CONTACT_PHONE=+91 82007 05348

# ------------------------------------------------------------------------------
# PostgreSQL Database Persistence (Optional)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/netu_techno?schema=public"

# ------------------------------------------------------------------------------
# Email Notifications Setup (Nodemailer)
# ------------------------------------------------------------------------------
# All website enquiries are routed to this address:
EMAIL_TO=netutechno@gmail.com
EMAIL_FROM="Netu Techno Inquiries <netutechno@gmail.com>"

# --- Option A: Using your Gmail account (Recommended & simplest) ---
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password under "App passwords": https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password into SMTP_PASSWORD below:
SMTP_SERVICE=gmail
SMTP_USER=netutechno@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Option B: Custom SMTP Server (Hostinger, AWS SES, SendGrid, Brevo, etc.) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=netutechno@gmail.com
# SMTP_PASSWORD=your_password
