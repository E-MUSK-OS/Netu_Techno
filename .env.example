# ==============================================================================
# Netu Techno — Environment Configuration Guide
# ==============================================================================

# Site URL (Canonical URL for SEO, Open Graph tags, and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://netutechno.com

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# If left empty, tracking scripts are not injected.
NEXT_PUBLIC_GA_ID=

# Contact Form Details (Publicly visible placeholder overrides)
NEXT_PUBLIC_CONTACT_EMAIL=contact@netutechno.com
NEXT_PUBLIC_CONTACT_PHONE=+91-XXXXXXXXXX

# ------------------------------------------------------------------------------
# PostgreSQL Database Persistence (Optional)
# If provided, submissions to /api/contact are persisted to PostgreSQL via Prisma.
# If omitted, leads are processed safely with email dispatch and logged without breaking.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/netu_techno?schema=public"

# ------------------------------------------------------------------------------
# SMTP Email Notifications (Nodemailer)
# Configure an SMTP server (AWS SES, SendGrid, Postmark, Mailgun, or standard SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=secure-smtp-password
EMAIL_FROM="Netu Techno <no-reply@netutechno.com>"
EMAIL_TO=leads@netutechno.com
